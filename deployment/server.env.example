# StreamIT Server Environment Variables
# This file should be placed at: /var/www/streamIT/server/.env

# Server Configuration
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://streamit:streamit@localhost:5432/streamit

# LiveKit Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend URL (for generating room links)
FRONTEND_URL=https://streamit-suraj.duckdns.org

# Node Environment
NODE_ENV=production
