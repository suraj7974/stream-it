// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model for storing call room metadata
model CallRoom {
  id            String   @id @default(uuid())
  roomId        String   @unique  // Unique UUID for URL
  displayName   String              // User-friendly name (can be duplicate)
  roomType      String              // "audio" or "video"
  createdAt     DateTime @default(now())
  expiresAt     DateTime?           // When room link expires (null = no expiry)
  isActive      Boolean  @default(true)
  createdBy     String?             // Future: user who created it
  
  @@map("call_rooms")
}

// Model for storing participant history (optional for analytics)
model Participant {
  id              String   @id @default(uuid())
  name            String
  roomId          String
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  
  @@map("participants")
}
